{
  "title": "SetViewSettings customLayers stores a view's own layer states, changes only the fields given, and the view applies them when opened; GetViewSettings reads them back",
  "minTapir": "2.0.2",
  "minArchicad": "27",
  "steps": [
    {
      "id": "two layers, shown and unlocked",
      "command": "CreateLayers",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "layerDataArray": [
          { "name": "TapirCheck custom layers A", "isHidden": false, "isLocked": false, "isWireframe": false, "intersectionGroupNr": 1 },
          { "name": "TapirCheck custom layers B", "isHidden": false, "isLocked": false, "isWireframe": false, "intersectionGroupNr": 1 }
        ],
        "overwriteExisting": true
      },
      "save": {
        "layerA": "attributeIds[0].attributeId.guid",
        "layerB": "attributeIds[1].attributeId.guid"
      },
      "expect": [
        { "path": "attributeIds", "len": 2, "name": "both layers created" }
      ]
    },
    {
      "id": "a story of the Project Map",
      "command": "GetNavigatorItemTree",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "navigatorMapId": "ProjectMap"
      },
      "save": {
        "story": "navigatorItemTree.children[0].navigatorItem.children[0].navigatorItem.navigatorItemId.guid"
      },
      "expect": [
        { "path": "navigatorItemTree.children[0].navigatorItem.children[0].navigatorItem.type", "eq": "StoryItem", "name": "first item of the first Project Map group is a story" }
      ]
    },
    {
      "id": "folder at the View Map root",
      "command": "CreateViewMapFolder",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "folderName": "TapirCheck custom layers folder"
      },
      "save": {
        "folder": "navigatorItemId.guid"
      },
      "expect": [
        { "path": "navigatorItemId.guid", "exists": true, "name": "folder created" }
      ]
    },
    {
      "id": "view of the story",
      "command": "CreateViewsInViewMap",
      "creates": false,
      "stopOnFail": true,
      "params": {
        "viewsData": [
          { "navigatorItemId": { "guid": "${story}" }, "parentNavigatorItemId": { "guid": "${folder}" }, "name": "TapirCheck custom layers view" }
        ]
      },
      "save": {
        "view": "navigatorItems[0].navigatorItemId.guid"
      },
      "expect": [
        { "path": "navigatorItems[0].navigatorItemId.guid", "exists": true, "name": "view created" }
      ]
    },
    {
      "id": "A hidden, B locked",
      "command": "SetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIdsWithViewSettings": [
          { "navigatorItemId": { "guid": "${view}" }, "viewSettings": { "customLayers": [
            { "attributeId": { "guid": "${layerA}" }, "isHidden": true },
            { "attributeId": { "guid": "${layerB}" }, "isLocked": true }
          ] } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true }
      ]
    },
    {
      "id": "the view stores custom layers",
      "command": "GetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view}" } } ]
      },
      "expect": [
        { "path": "viewSettings[0].layerCombination", "eq": "", "name": "no layer combination name" },
        { "path": "viewSettings[0].saveFlags.layers", "eq": true, "name": "layers stored in the view" },
        { "path": "viewSettings[0].customLayers[0].attributeId.guid", "exists": true, "name": "custom layer states returned" }
      ]
    },
    {
      "id": "open the view",
      "command": "ChangeWindow",
      "creates": false,
      "params": { "navigatorItemId": { "guid": "${view}" } },
      "expect": [
        { "path": "success", "eq": true }
      ]
    },
    {
      "id": "the view applied A hidden and B locked",
      "command": "GetLayers",
      "creates": false,
      "params": {
        "attributeIds": [ { "attributeId": { "guid": "${layerA}" } }, { "attributeId": { "guid": "${layerB}" } } ]
      },
      "expect": [
        { "path": "layers[0].isHidden", "eq": true, "name": "A hidden" },
        { "path": "layers[0].isLocked", "eq": false, "name": "A unlocked" },
        { "path": "layers[1].isHidden", "eq": false, "name": "B shown" },
        { "path": "layers[1].isLocked", "eq": true, "name": "B locked" }
      ]
    },
    {
      "id": "only A shown again",
      "command": "SetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIdsWithViewSettings": [
          { "navigatorItemId": { "guid": "${view}" }, "viewSettings": { "customLayers": [
            { "attributeId": { "guid": "${layerA}" }, "isHidden": false }
          ] } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": true }
      ]
    },
    {
      "id": "open the view again",
      "command": "ChangeWindow",
      "creates": false,
      "params": { "navigatorItemId": { "guid": "${view}" } },
      "expect": [
        { "path": "success", "eq": true }
      ]
    },
    {
      "id": "A shown and B still locked",
      "command": "GetLayers",
      "creates": false,
      "params": {
        "attributeIds": [ { "attributeId": { "guid": "${layerA}" } }, { "attributeId": { "guid": "${layerB}" } } ]
      },
      "expect": [
        { "path": "layers[0].isHidden", "eq": false, "name": "A shown" },
        { "path": "layers[1].isLocked", "eq": true, "name": "B kept its lock: a partial list changes only what it gives" }
      ]
    },
    {
      "id": "with a layer combination name",
      "command": "SetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIdsWithViewSettings": [
          { "navigatorItemId": { "guid": "${view}" }, "viewSettings": { "layerCombination": "TapirCheck any name", "customLayers": [
            { "attributeId": { "guid": "${layerA}" }, "isHidden": true }
          ] } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "customLayers with a layerCombination name refused" }
      ]
    },
    {
      "id": "with an attributeId of no layer",
      "command": "SetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIdsWithViewSettings": [
          { "navigatorItemId": { "guid": "${view}" }, "viewSettings": { "drawingScale": 20, "customLayers": [
            { "attributeId": { "guid": "00000000-0000-0000-0000-00000000BEEF" }, "isHidden": true }
          ] } }
        ]
      },
      "expect": [
        { "path": "executionResults[0].success", "eq": false, "name": "unknown layer refused" }
      ]
    },
    {
      "id": "the refused items wrote nothing",
      "command": "GetViewSettings",
      "creates": false,
      "params": {
        "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view}" } } ]
      },
      "expect": [
        { "path": "viewSettings[0].layerCombination", "eq": "", "name": "still custom layers" },
        { "path": "viewSettings[0].drawingScale", "ne": 20, "name": "scale of the refused item not written" }
      ]
    }
  ],
  "teardown": [
    {
      "command": "DeleteNavigatorItems",
      "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${view}" } } ] }
    },
    {
      "command": "DeleteNavigatorItems",
      "params": { "navigatorItemIds": [ { "navigatorItemId": { "guid": "${folder}" } } ] }
    }
  ]
}
